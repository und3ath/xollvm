# Build trees
/build/
/out/
build-*/
cmake-build-*/

# CMake artifacts
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# run tests dirs
obf_reports/
obf_rt_work/
deobf_bench_work/

# Local test-runner script (personal, not for public repo)
run_regression.ps1

# Compiled objects / libs / plugins
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.pdb

# Generated AES stub (produced by the aes_stub_inc target at build time)
aes_stub.bc
aes_stub_bc.inc

# Python
__pycache__/

# Local project ruleset (not for public repo)
CLAUDE.md

# Editor / IDE
.vs/
.idea/
.vscode/
*.user

# Throwaway dev scratch — prototype demos, PoCs, perf probes.
# Keep these in the scratchpad, never track them. Underscore-prefixed
# package modules (_common.py, _ir.py, __init__.py) are NOT scratch.
**/_*_demo.py
**/_*_perf.py
**/_*_poc.py
**/_v[0-9]*_*.py
**/*_scratch.py
**/*_playground.py

# Private planning docs (never commit)
.claude/
docs/VM_GAP_ANALYSIS.md
docs/design/
