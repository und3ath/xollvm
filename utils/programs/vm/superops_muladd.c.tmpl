#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

__attribute__((noinline, annotate("{annotation}")))
uint32_t obf_target(uint32_t x, uint32_t y) {{
    uint32_t h = x ^ 0x9E3779B9u;
    uint32_t data[8];
    data[0] = x; data[1] = y; data[2] = x ^ y; data[3] = x + y;
    data[4] = x - y; data[5] = x | y; data[6] = x & y; data[7] = ~(x ^ y);

    for (int i = 0; i < 8; i++) {{
        h = h * 31u + data[i];
    }}

    uint32_t a = x + 1u, b = y + 2u, c = h ^ 3u;
    uint32_t p0 = a * b + c;
    uint32_t p1 = b * c + a;
    uint32_t p2 = c * a + b;
    uint32_t poly = p0 * 2u + p1 * 3u + p2;

    uint32_t out = h + poly;
    return out;
}}

int main(int argc, char** argv) {{
    uint32_t x = (argc > 1) ? (uint32_t)strtoul(argv[1], 0, 0) : 123u;
    uint32_t y = (argc > 2) ? (uint32_t)strtoul(argv[2], 0, 0) : 456u;
    uint32_t r = obf_target(x, y);
    printf("R=%u\n", r);
    return (int)(r & 0xFFu);
}}
